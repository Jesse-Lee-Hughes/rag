{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(./dev.sh:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(uvicorn:*)",
      "Bash(pytest:*)",
      "Bash(black:*)",
      "Bash(isort:*)",
      "Bash(flake8:*)",
      "Bash(npm run:*)",
      "Bash(claude -p:*)"
    ]
  }
}
