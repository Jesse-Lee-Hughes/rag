FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (Node.js is needed for the Claude Code CLI)
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install the Claude Code CLI so the backend can run the "claude" LLM provider
# (uses the subscription mounted at ~/.claude, no API key required).
RUN npm install -g @anthropic-ai/claude-code

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install development dependencies
COPY requirements-dev.txt .
RUN pip install --no-cache-dir -r requirements-dev.txt

# Install VS Code Python extension dependencies
RUN pip install --no-cache-dir black flake8

# Set PYTHONPATH
ENV PYTHONPATH=/app

# Command to run with hot-reload
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"] 