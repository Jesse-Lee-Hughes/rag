# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql://user:password@db:5432/rag_db
POSTGRES_DB=rag_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# --- LLM provider selection ---
# One of: claude | azure | openai | mock  (default: claude)
LLM_PROVIDER=claude

# --- Claude provider (claude -p CLI, uses your subscription; no API key) ---
# Optional model alias, e.g. claude-sonnet-5. Blank = CLI default.
CLAUDE_MODEL=
# CLAUDE_BIN=claude
# CLAUDE_TIMEOUT=120

# --- Azure OpenAI (only if LLM_PROVIDER=azure) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_MODEL=gpt-35-turbo

# --- OpenAI (only if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
